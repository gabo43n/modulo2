# Variables de entorno para el modulo CLM (empresa_cliente, contrato, clausula)
# que se conecta a PostgreSQL. El resto de esta API (contactos, grupos, auth)
# sigue usando el archivo JSON en data/agenda.json y no necesita estas variables.
#
# Copia este archivo a ".env" y completa con los datos de tu instalacion local
# de PostgreSQL. ".env" ya esta en .gitignore, nunca lo subas a un repositorio.

PGHOST=localhost
PGPORT=5432
PGDATABASE=clm_db
PGUSER=postgres
PGPASSWORD=postgres

# Puerto en el que corre esta API (ya definido por el proyecto original)
PORT=3000
# Fuerza SSL incluso contra un Postgres local/remoto que no sea Supabase
# (normalmente no lo necesitas si es local). Por defecto: false.
# PGSSL=true

# Puerto en el que corre esta API (ya definido por el proyecto original)
PORT=3000

# -----------------------------------------------------------------------------
# Login del dashboard CLM (http://localhost:3000/clm/)
# -----------------------------------------------------------------------------
# Es un solo usuario "admin" fijo (no una tabla de usuarios en Postgres).
# CLM_JWT_SECRET: cualquier texto largo y aleatorio, sirve para firmar la
# sesion (cambialo si esto llega a produccion de verdad).
CLM_JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

CLM_ADMIN_USER=admin

# Este hash corresponde a la contraseña "clm12345" (para que puedas entrar
# la primera vez sin generar nada). CAMBIALA: corre
#   npm run clm:hash-password -- "tu-contraseña-nueva"
# y pega aqui el resultado.
CLM_JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio
CLM_ADMIN_USER=admin
CLM_ADMIN_PASSWORD_HASH=$2b$10$rGiypnwsv.wYDbxVBuuw/O5wkrp4CDaIUUyrvBiHk9un70zX5kXKG
